---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

type MyPageItem = {
	title: string;
	description: string;
	icon: string;
	link?: string;
	linkText?: string;
	tags?: string[];
};

type MyPageSection = {
	title: string;
	description?: string;
	items: MyPageItem[];
};

interface Props {
	title: string;
	description: string;
	icon: string;
	sections: MyPageSection[];
}

const { title, description, icon, sections } = Astro.props;
---

<MainGridLayout title={title} description={description}>
  <section class="card-base rounded-(--radius-large) px-6 py-6 sm:px-9 sm:py-7">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white dark:text-black/70">
          <Icon name={icon} class="text-[1.7rem]" />
        </div>
        <div>
          <h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 sm:text-3xl">{title}</h1>
          <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 sm:text-base">{description}</p>
        </div>
      </div>
    </div>
  </section>

  {sections.map((section) => (
    <section class="card-base mt-4 rounded-(--radius-large) px-6 py-6 sm:px-9 sm:py-7">
      <div class="mb-5">
        <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">{section.title}</h2>
        {section.description && (
          <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{section.description}</p>
        )}
      </div>

      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {section.items.map((item) => (
          <article class="rounded-lg border border-(--line-divider) px-4 py-4 transition-colors hover:border-(--primary)">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-(--primary)/10 text-(--primary)">
                <Icon name={item.icon} class="text-[1.35rem]" />
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{item.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{item.description}</p>
                {item.tags && item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {item.tags.map((tag) => (
                      <span class="rounded-md bg-black/5 px-2 py-1 text-xs text-neutral-600 dark:bg-white/10 dark:text-neutral-300">{tag}</span>
                    ))}
                  </div>
                )}
                {item.link && (
                  <a
                    href={item.link}
                    target={item.link.startsWith("http") ? "_blank" : undefined}
                    rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-(--primary) hover:underline"
                  >
                    <span>{item.linkText || "查看"}</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-base" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</MainGridLayout>
